# Copy to .env (gitignored). Env vars override data/config.json on every load.
# Generic key + base URL work for any OpenAI-compatible API (DeepSeek, OpenRouter, Groq, ...).
LLM_API_KEY=
LLM_BASE_URL=

# Provider-specific fallbacks
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
